"""
سكريبت لمرة وحدة (one-off) باش يحذف الفهرس القديم channelId_1
من collection "tickets" فـ MongoDB.

فين تحطو: حطو هاد الملف جنب main.py فـ نفس مجلد المشروع
(Estrada-roleplay--main/) باش يقدر يقرا MONGO_URI و MONGO_DB_NAME
من نفس الـ environment لي خدام بيها البوت.

كيفاش تشغلو:
    python fix_ticket_index.py

خاص يكون عندك نفس متغيرات البيئة (env vars) لي خدام بيها البوت:
    MONGO_URI      -> رابط الاتصال ديال MongoDB
    MONGO_DB_NAME  -> اسم القاعدة (افتراضياً "Estrada")

إلا كنتي خدام بـ .env ملف، تأكد بلي load_dotenv() او الأداة لي كتقرا
.env مفعلة قبل ما تجري هاد السكريبت، أو صيفط المتغيرات يدوياً:
    MONGO_URI="mongodb+srv://..." python fix_ticket_index.py
"""

import os
import sys

MONGO_URI = os.getenv("MONGO_URI", "").strip()
MONGO_DB_NAME = os.getenv("MONGO_DB_NAME", "Estrada").strip()

if not MONGO_URI:
    print("❌ ماكاينش MONGO_URI فـ environment ديالك. صيفطو وعاود جرب.")
    sys.exit(1)

from pymongo import MongoClient

client = MongoClient(MONGO_URI, serverSelectionTimeoutMS=5000)
db = client[MONGO_DB_NAME]
coll = db["tickets"]

print(f"متصل بـ: {MONGO_DB_NAME}.tickets")

existing_indexes = coll.index_information()
print("الفهارس الموجودة دابا:")
for name in existing_indexes:
    print(f"  - {name}")

if "channelId_1" in existing_indexes:
    coll.drop_index("channelId_1")
    print("✅ تحذف الفهرس channelId_1 بنجاح. البوت خاصو يخزن التذاكر عادي دابا.")
else:
    print("ℹ️  الفهرس channelId_1 ماكاينش أصلاً — يمكن تحذف من قبل، ماشي مشكل.")

client.close()
